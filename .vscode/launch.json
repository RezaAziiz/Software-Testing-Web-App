{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI (uvicorn)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload"
      ],
      "env": {
        "ENVIRONMENT": "development"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/backend-dev"
    }
  ]
}