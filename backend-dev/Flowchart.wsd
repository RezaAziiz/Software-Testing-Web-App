@startuml
title Flowchart Eksekusi Test Case — Sistem Eksisting

skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #E8F4FD
    BorderColor #2196F3
    FontSize 11
}
skinparam diamond {
    BackgroundColor #FFF9C4
    BorderColor #FFC107
    FontSize 10
}

start
:Klik Eksekusi;
:Kirim Request API;
:Fetch Data Modul;
:Generate File Disk;
:Eksekusi Gradle CLI;

if (Build Berhasil?) then (ya)
    :Read JaCoCo XML;
    :Hitung Coverage;
else (tidak)
    :Set Coverage 0%;
endif

:Update Status & CFG;
:Kirim Response API;

if (Pass Minimum?) then (ya)
    :Render Halaman Pass;
else (tidak)
    :Render Halaman Fail;
endif

stop
@enduml
